@host = http://localhost:4004
@service = {{host}}/odata/v4/ticketing

### 1. OPEN Status Ticket
POST {{service}}/Tickets
Content-Type: application/json

{
  "ticketNumber": "INC100001",
  "subject": "Sales order creation failing",
  "description": "Users are unable to create sales orders due to a validation error in SAP SD.",
  "priority": "MEDIUM",
  "status": "OPEN",
  "category": {
    "name": "SAP-SD"
  },
  "agent": {
    "ID": "a14d8e95-3f6b-42c7-8d21-9c6e2f4b3303"
  },
  "comments": [
    {
      "text": "Issue reported by the sales team and awaiting investigation."
    }
  ]
}

